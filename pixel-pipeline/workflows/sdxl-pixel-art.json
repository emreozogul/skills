{
  "_meta": {
    "name": "sdxl-pixel-art",
    "description": "SDXL base + optional Pixel Art XL LoRA. Generates 1024x1024 by default; pipe through `pix process` to downscale and palette-snap.",
    "tunable_nodes": {
      "checkpoint": "4",
      "lora": "10",
      "positive_prompt": "6",
      "negative_prompt": "7",
      "latent": "5",
      "sampler": "3",
      "save": "9"
    }
  },
  "3": {
    "inputs": {
      "seed": 42,
      "steps": 25,
      "cfg": 7.5,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1.0,
      "model": ["10", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    },
    "class_type": "KSampler",
    "_meta": { "title": "Diffuse" }
  },
  "4": {
    "inputs": {
      "ckpt_name": "sd_xl_base_1.0.safetensors"
    },
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "Load SDXL" }
  },
  "5": {
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    },
    "class_type": "EmptyLatentImage",
    "_meta": { "title": "Latent" }
  },
  "6": {
    "inputs": {
      "text": "pixel art, retro 16-bit, clean linework, vibrant palette, white background, no anti-aliasing",
      "clip": ["10", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive" }
  },
  "7": {
    "inputs": {
      "text": "blurry, photorealistic, anti-aliased, soft edges, 3d render, photograph, jpeg artifacts, watermark",
      "clip": ["10", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative" }
  },
  "8": {
    "inputs": {
      "samples": ["3", 0],
      "vae": ["4", 2]
    },
    "class_type": "VAEDecode",
    "_meta": { "title": "Decode" }
  },
  "9": {
    "inputs": {
      "filename_prefix": "pix",
      "images": ["8", 0]
    },
    "class_type": "SaveImage",
    "_meta": { "title": "Save" }
  },
  "10": {
    "inputs": {
      "lora_name": "pixel-art-xl-v1.1.safetensors",
      "strength_model": 1.0,
      "strength_clip": 1.0,
      "model": ["4", 0],
      "clip": ["4", 1]
    },
    "class_type": "LoraLoader",
    "_meta": { "title": "Pixel Art LoRA" }
  }
}
